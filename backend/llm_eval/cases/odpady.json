     {
      "id": "b185",
      "kind": "heading",
      "text": "E.3 WYSOKOŚĆ OPŁATY DLA CZĘŚCI NIERUCHOMOŚCI NA KTÓREJ NIE"
     },
     {
      "id": "b186",
      "kind": "heading",
      "text": "ZAMIESZKUJĄ MIESZKAŃCY, A POWSTAJĄ ODPADY KOMUNALNE"
     },
     {
      "id": "b187",
