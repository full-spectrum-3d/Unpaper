{
  "name": "coi-cf-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "api:check": "sh scripts/api-check.sh",
    "api:generate": "npm run api:export && ng-openapi-gen --config ng-openapi-gen.json",
    "api:export": "command -v uv >/dev/null || { echo 'api:export wymaga uv (https://docs.astral.sh/uv/)' >&2; exit 1; }; uv run --locked --project ../backend python scripts/export-openapi.py ../docs/openapi.json",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "storybook": "ng run coi-cf-frontend:storybook",
    "build-storybook": "ng run coi-cf-frontend:build-storybook",
    "test:storybook": "vitest run --project storybook"
  },
  "private": true,
  "packageManager": "npm@11.19.1",
  "dependencies": {
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/forms": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@angular/router": "^22.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/open-sans": "^5.3.0",
    "@ngrx/effects": "^22.0.1",
    "@ngrx/entity": "^22.0.1",
    "@ngrx/store": "^22.0.1",
    "@ngrx/store-devtools": "^22.0.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.7.3",
    "@angular-devkit/architect": "^0.2203.0",
    "@angular-devkit/build-angular": "^22.3.0",
    "@angular-devkit/core": "^22.3.0",
    "@angular/animations": "^22.3.0",
    "@angular/build": "^22.3.0",
    "@angular/cli": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "@storybook/addon-a11y": "^10.6.8",
    "@storybook/addon-docs": "^10.6.8",
    "@storybook/addon-vitest": "^10.6.8",
    "@storybook/angular-vite": "^10.6.8",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/node": "^24.0.0",
    "@vitest/browser-playwright": "5.1.1",
    "@vitest/coverage-v8": "5.1.1",
    "jsdom": "^31.0.0",
    "ng-openapi-gen": "^1.1.0",
    "playwright": "^1.65.1",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "storybook": "^10.6.8",
    "tailwindcss": "^4.1.12",
    "typescript": "~6.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.0.0"
  }
}
