    },
    "/api/v1/health/ready": {
      "get": {
        "description": "Gotowość: serwer modelu osiągalny i model trybu domyślnego pobrany.\n\n`degraded` wymienia brakujące tryby LLM oraz `converter`, gdy w obrazie nie ma\nLibreOffice (wtedy DOC/ODS dostają 415, reszta formatów działa).",
        "operationId": "ready_api_v1_health_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
