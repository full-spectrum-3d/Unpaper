    "securitySchemes": {
      "OAuth2PasswordBearer": {
        "flows": {
          "password": {
            "scopes": {},
            "tokenUrl": "/api/v1/auth/token"
          }
        },
        "type": "oauth2"
      }
    }
  },
  "info": {
    "title": "COI - Cyfryzacja formularzy",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/auth/token": {
      "post": {
        "operationId": "issue_token_api_v1_auth_token_post",
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/Body_issue_token_api_v1_auth_token_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Nieprawidłowy login lub hasło"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Issue Token",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/dictionaries": {
      "get": {
        "description": "Słowniki predefiniowane (`PREDEFINED`), potem proponowane (`PROPOSED`, z pozycjami).",
        "operationId": "list_dictionaries_api_v1_dictionaries_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "additionalProperties": true,
                    "type": "object"
                  },
                  "title": "Response List Dictionaries Api V1 Dictionaries Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Brak lub nieprawidłowy token"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Token bez wymaganej roli"
          }
        },
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ],
        "summary": "List Dictionaries",
        "tags": [
          "catalog"
        ]
      }
    },
    "/api/v1/forms/convert": {
      "post": {
        "description": "Główny endpoint: 1 plik → JSON w formacie importu (lub `{form, report}`).",
        "operationId": "convert_api_v1_forms_convert_post",
        "parameters": [
          {
            "description": "Dołącz raport konwersji (spec §6.2)",
            "in": "query",
            "name": "report",
            "required": false,
            "schema": {
              "default": false,
              "description": "Dołącz raport konwersji (spec §6.2)",
              "title": "Report",
              "type": "boolean"
            }
          },
          {
            "description": "Model LLM z `LLM_MODEL` albo `LLM_MODELS`; domyślnie `LLM_MODEL`",
            "in": "query",
            "name": "model",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Model LLM z `LLM_MODEL` albo `LLM_MODELS`; domyślnie `LLM_MODEL`",
              "title": "Model"
            }
          },
          {
            "description": "Źródło imienia, nazwiska i PESEL w sekcji „Twoje dane”; domyślnie INITIAL_DATA_IDENTITY_SOURCE",
            "in": "query",
            "name": "identitySource",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "PESEL",
                    "MLPZ"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Źródło imienia, nazwiska i PESEL w sekcji „Twoje dane”; domyślnie INITIAL_DATA_IDENTITY_SOURCE",
              "title": "Identitysource"
            }
          }
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "properties": {
                  "file": {
                    "description": "Dokładnie jeden plik: pdf, doc, docx, ods, xlsx, jpg, jpeg albo png",
                    "format": "binary",
                    "type": "string"
                  },
                  "password": {
                    "description": "Hasło do dokumentu zabezpieczonego hasłem (po odpowiedzi DOCUMENT_PASSWORD_REQUIRED)",
                    "type": "string"
                  }
                },
                "required": [
                  "file"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object"
                }
              }
            },
            "description": "Konfiguracja formularza w formacie importu (spec §7) albo, przy `report=true`, obiekt `{form, report}`. Nagłówek `X-Conversion-Warnings` podaje liczbę ostrzeżeń.",
            "headers": {
              "X-Conversion-Warnings": {
                "description": "Liczba ostrzeżeń",
                "schema": {
                  "type": "integer"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Brak pliku, kilka plików albo niedozwolona nazwa pliku"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Brak lub nieprawidłowy token"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Token bez wymaganej roli"
          },
          "413": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Plik większy niż MAX_FILE_SIZE_MB"
          },
          "415": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Nieobsługiwany format albo zawartość niezgodna z rozszerzeniem"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Dokument uszkodzony, zbyt złożony albo zabezpieczony hasłem; niepoprawne `identitySource`; model spoza LLM_MODELS"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "SERVER_BUSY: serwer przetwarza inne pliki (nagłówek Retry-After)"
          },
          "504": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Przekroczono REQUEST_TIMEOUT_S"
          }
        },
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ],
        "summary": "Convert",
        "tags": [
          "forms"
        ]
      }
    },
    "/api/v1/forms/validate": {
      "post": {
        "description": "Walidacja dowolnego JSON-a formularza → `{valid, errors[], warnings[]}`.",
        "operationId": "validate_api_v1_forms_validate_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": true,
                "description": "Konfiguracja formularza w formacie importu (spec §7)",
                "title": "Form",
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Validate Api V1 Forms Validate Post",
                  "type": "object"
                }
              }
            },
            "description": "Wynik weryfikacji: JSON Schema i reguły R01-R15, bez autonaprawy"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Brak lub nieprawidłowy token"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Token bez wymaganej roli"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Ciało nie jest obiektem JSON"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "SERVER_BUSY: serwer przetwarza inne żądania (nagłówek Retry-After)"
          }
        },
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ],
        "summary": "Validate",
        "tags": [
          "forms"
        ]
      }
    },
    "/api/v1/health/live": {
      "get": {
        "operationId": "live_api_v1_health_live_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LiveResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Live",
        "tags": [
          "health"
        ]
      }
    },
    "/api/v1/health/ready": {
      "get": {
        "description": "Gotowość: serwer modelu osiągalny i model pobrany.\n\n`degraded` wymienia `converter`, gdy w obrazie nie ma\nLibreOffice (wtedy DOC/ODS dostają 415, reszta formatów działa).",
        "operationId": "ready_api_v1_health_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "LLM_UNAVAILABLE: serwer modelu nieosiągalny albo brak modelu; SERVICE_UNAVAILABLE: brak libmagic albo Tesseracta w obrazie"
          }
        },
        "summary": "Ready",
        "tags": [
          "health"
        ]
      }
    },
    "/api/v1/initial-data-sources": {
      "get": {
        "description": "Źródła danych inicjalnych z atrybutami (spec §8.5). `ref` trafia do `defaultValue`.",
        "operationId": "list_initial_data_sources_api_v1_initial_data_sources_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "additionalProperties": true,
                    "type": "object"
                  },
                  "title": "Response List Initial Data Sources Api V1 Initial Data Sources Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Brak lub nieprawidłowy token"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Token bez wymaganej roli"
          }
        },
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ],
        "summary": "List Initial Data Sources",
        "tags": [
          "catalog"
        ]
      }
    }
  }
}
