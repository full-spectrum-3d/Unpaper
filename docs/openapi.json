          "title",
          "status",
          "code"
        ],
        "title": "ProblemDetail",
        "type": "object"
      },
      "ReadyResponse": {
        "properties": {
          "degraded": {
            "anyOf": [
              {
                "items": {
                  "const": "converter",
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "Działające z ograniczeniami części; `converter`: brak LibreOffice, pliki DOC i ODS dostają 415",
            "title": "Degraded"
          },
          "status": {
            "const": "ok",
            "default": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "title": "ReadyResponse",
        "type": "object"
      },
      "TokenResponse": {
        "properties": {
          "access_token": {
            "title": "Access Token",
            "type": "string"
          },
          "expires_in": {
            "title": "Expires In",
            "type": "integer"
          },
          "token_type": {
            "const": "bearer",
            "default": "bearer",
            "title": "Token Type",
            "type": "string"
