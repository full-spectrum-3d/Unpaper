  "info": {
    "title": "COI - Cyfryzacja formularzy",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/auth/token": {
      "post": {
        "operationId": "issue_token_api_v1_auth_token_post",
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/Body_issue_token_api_v1_auth_token_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Nieprawidłowy login lub hasło"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Issue Token",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/dictionaries": {
      "get": {
        "description": "Słowniki predefiniowane (`PREDEFINED`), potem proponowane (`PROPOSED`, z pozycjami).",
        "operationId": "list_dictionaries_api_v1_dictionaries_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "additionalProperties": true,
                    "type": "object"
                  },
                  "title": "Response List Dictionaries Api V1 Dictionaries Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Brak lub nieprawidłowy token"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Token bez wymaganej roli"
          }
        },
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ],
        "summary": "List Dictionaries",
        "tags": [
          "catalog"
        ]
      }
    },
    "/api/v1/forms/convert": {
      "post": {
        "description": "Główny endpoint: 1 plik → JSON w formacie importu (lub {form, report}).\n\n`mode`: tryb analizy LLM (`accurate`/`fast`), domyślnie `LLM_DEFAULT_MODE`.",
        "operationId": "convert_api_v1_forms_convert_post",
        "parameters": [
          {
            "in": "query",
            "name": "report",
            "required": false,
            "schema": {
              "default": false,
              "title": "Report",
              "type": "boolean"
            }
          },
          {
            "in": "query",
            "name": "mode",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "accurate",
                    "fast"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Mode"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Convert Api V1 Forms Convert Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Brak lub nieprawidłowy token"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Token bez wymaganej roli"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ],
        "summary": "Convert",
        "tags": [
          "forms"
        ]
      }
    },
    "/api/v1/forms/validate": {
      "post": {
        "description": "Walidacja dowolnego JSON-a formularza → {valid, errors[], warnings[]}.",
        "operationId": "validate_api_v1_forms_validate_post",
        "responses": {
