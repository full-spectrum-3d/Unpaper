# Konfiguracja wg specyfikacji §12. Skopiuj do .env i uzupełnij sekrety.
APP_ENV=production
LOG_LEVEL=INFO

# Upload / limity
MAX_FILE_SIZE_MB=20
MAX_UNCOMPRESSED_MB=100
MAX_PDF_PAGES=30
MAX_IMAGE_PIXELS=60000000
SPOOL_MAX_MB=10
MAX_CONCURRENT_JOBS=2
REQUEST_TIMEOUT_S=180

# Uwierzytelnianie
AUTH_ENABLED=true
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ISSUER=coi-cf
JWT_AUDIENCE=coi-cf-api
JWT_EXPIRES_MIN=60
API_USER=
API_PASSWORD_HASH=
CORS_ORIGINS=http://localhost:8080

# LLM
LLM_BASE_URL=http://llm:11434
LLM_MODEL=qwen3:8b
LLM_TIMEOUT_S=120
LLM_TEMPERATURE=0
LLM_SEED=42
LLM_NUM_CTX=16384
EXTRACTION_VLM_ENABLED=false
VLM_MODEL=qwen2.5vl:7b

# Ekstrakcja / konwersja
OCR_LANG=pol
OCR_DPI=300
CONVERTER_TIMEOUT_S=60

# Budowa formularza
INITIAL_DATA_IDENTITY_SOURCE=MLPZ
FINISH_PAGE_STYLE=sample
MAX_SECTIONS_PER_PAGE=8
