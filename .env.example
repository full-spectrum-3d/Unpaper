# Konfiguracja wg specyfikacji §12. Skopiuj do .env (katalog główny repo) i uzupełnij sekrety:
#   JWT_SECRET:        python -c "import secrets; print(secrets.token_urlsafe(48))"
#   API_PASSWORD_HASH: cd backend && uv run python -m app.core.security hash-password
#                      (albo `make password-hash`, jeśli masz make)
# Docker compose wczytuje .env przez env_file; lokalny uvicorn czyta ten sam plik.
# Zmienne środowiskowe mają pierwszeństwo przed plikiem.
APP_ENV=production
LOG_LEVEL=INFO

# Upload / limity
MAX_FILE_SIZE_MB=20
MAX_UNCOMPRESSED_MB=100
MAX_PDF_PAGES=30
MAX_IMAGE_PIXELS=60000000
SPOOL_MAX_MB=10
MAX_CONCURRENT_JOBS=2
REQUEST_TIMEOUT_S=180

# Uwierzytelnianie (spec §10.1)
# AUTH_ENABLED=false działa tylko przy APP_ENV=development.
AUTH_ENABLED=true
# HS256 (domyślnie): wymagany JWT_SECRET, min. 32 bajty (polecenie na górze pliku).
JWT_ALGORITHM=HS256
JWT_SECRET=
# RS256: JWT_PUBLIC_KEY wymagany; JWT_PRIVATE_KEY opcjonalny.
#   Bez klucza prywatnego API tylko weryfikuje tokeny wydane przez inny system,
#   a /auth/token jest wyłączony. Klucze najlepiej jako Docker secrets
#   (/run/secrets/jwt_public_key, /run/secrets/jwt_private_key) albo w jednej linii z \n.
# JWT_PUBLIC_KEY=
# JWT_PRIVATE_KEY=
JWT_ISSUER=coi-cf
JWT_AUDIENCE=coi-cf-api
JWT_EXPIRES_MIN=60
# Tolerancja różnicy zegarów przy weryfikacji exp/nbf/iat (sekundy).
JWT_LEEWAY_S=30
# Mapowanie claimów tokenów brokera tożsamości (np. Keycloak przed Węzłem Krajowym,
# docs/architecture/wezel-krajowy.md). Ścieżki z kropką = claim zagnieżdżony.
JWT_SUBJECT_CLAIM=sub
JWT_ROLES_CLAIM=roles
# Pusta = brak wymogu roli. Ustawiona = token musi ją zawierać, inaczej 403.
# Keycloak: JWT_ROLES_CLAIM=realm_access.roles, JWT_SUBJECT_CLAIM=preferred_username
JWT_REQUIRED_ROLE=
# Konto techniczne (wymagane, gdy API wydaje tokeny).
# Hash wygeneruj: `make password-hash`. Wpisz go w POJEDYNCZYCH cudzysłowach,
# inaczej docker compose potraktuje znaki $ jako zmienne.
API_USER=
API_PASSWORD_HASH=''

# HTTP – lista originów rozdzielona przecinkami
CORS_ORIGINS=http://localhost:8080

# LLM
LLM_BASE_URL=http://llm:11434
LLM_MODEL=qwen3:8b
LLM_TIMEOUT_S=120
LLM_TEMPERATURE=0
LLM_SEED=42
LLM_NUM_CTX=16384
EXTRACTION_VLM_ENABLED=false
VLM_MODEL=qwen2.5vl:7b

# Ekstrakcja / konwersja
OCR_LANG=pol
OCR_DPI=300
CONVERTER_TIMEOUT_S=60

# Budowa formularza
INITIAL_DATA_IDENTITY_SOURCE=MLPZ
FINISH_PAGE_STYLE=sample
MAX_SECTIONS_PER_PAGE=8
