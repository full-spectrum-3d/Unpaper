# Konfiguracja wg specyfikacji §12 (opis zmiennych: README.md, sekcja Konfiguracja).
# Najprościej: scripts/init-env.sh (albo make env) tworzy .env z tego pliku z losowym
# JWT_SECRET, kontem API_USER=admin i hashem wygenerowanego hasła.
# Ręcznie: skopiuj do .env (katalog główny repo) i uzupełnij sekrety:
#   JWT_SECRET:        python -c "import secrets; print(secrets.token_urlsafe(48))"
#   API_PASSWORD_HASH: make password-hash (liczony w obrazie API)
#                      albo: cd backend && uv run python -m app.core.security hash-password
# Docker compose wczytuje .env przez env_file; lokalny uvicorn czyta ten sam plik.
# Zmienne środowiskowe mają pierwszeństwo przed plikiem.
APP_ENV=production
LOG_LEVEL=INFO

# Upload / limity
MAX_FILE_SIZE_MB=20
MAX_UNCOMPRESSED_MB=100
MAX_PDF_PAGES=30
MAX_IMAGE_PIXELS=100000000
SPOOL_MAX_MB=10
MAX_CONCURRENT_JOBS=2
REQUEST_TIMEOUT_S=540

# Uwierzytelnianie (spec §10.1)
# AUTH_ENABLED=false działa tylko przy APP_ENV=development.
AUTH_ENABLED=true
# HS256 (domyślnie): wymagany JWT_SECRET, min. 32 bajty (polecenie na górze pliku).
JWT_ALGORITHM=HS256
JWT_SECRET=
# RS256: JWT_PUBLIC_KEY wymagany; JWT_PRIVATE_KEY opcjonalny.
#   Bez klucza prywatnego API tylko weryfikuje tokeny wydane przez inny system,
#   a /auth/token jest wyłączony. Klucze najlepiej jako Docker secrets
#   (/run/secrets/jwt_public_key, /run/secrets/jwt_private_key) albo w jednej linii z \n.
# JWT_PUBLIC_KEY=
# JWT_PRIVATE_KEY=
JWT_ISSUER=coi-cf
JWT_AUDIENCE=coi-cf-api
JWT_EXPIRES_MIN=60
# Tolerancja różnicy zegarów przy weryfikacji exp/nbf/iat (sekundy).
JWT_LEEWAY_S=30
# Mapowanie claimów tokenów brokera tożsamości (np. Keycloak przed Węzłem Krajowym,
# docs/architecture/wezel-krajowy.md). Ścieżki z kropką = claim zagnieżdżony.
JWT_SUBJECT_CLAIM=sub
JWT_ROLES_CLAIM=roles
# Pusta = brak wymogu roli. Ustawiona = token musi ją zawierać, inaczej 403.
# Wymagana przy APP_ENV=production i RS256 bez klucza prywatnego (tokeny z brokera).
# Keycloak: JWT_ROLES_CLAIM=realm_access.roles, JWT_SUBJECT_CLAIM=preferred_username
JWT_REQUIRED_ROLE=
# Konto techniczne (wymagane, gdy API wydaje tokeny).
# Hash wygeneruj: `make password-hash`. Wpisz go w POJEDYNCZYCH cudzysłowach,
# inaczej docker compose potraktuje znaki $ jako zmienne.
API_USER=
API_PASSWORD_HASH=''
# Samodzielna rejestracja kont na stronie logowania (POST /api/v1/auth/register).
# Konta trafiają do SQLite na wolumenie api-data (USERS_DB_PATH ustawia docker-compose.yml).
# false = logować się może tylko konto techniczne powyżej.
REGISTRATION_ENABLED=true

# HTTP – lista originów rozdzielona przecinkami
CORS_ORIGINS=http://localhost:8080

# LLM
# Lokalny model w kontenerze `llm` (Ollama + pobranie modelu przez make model).
# Zewnętrzny serwer modelu: ustaw COMPOSE_PROFILES= (pusto) i LLM_BASE_URL na jego adres -
# wtedy compose nie buduje, nie uruchamia i nie pobiera niczego dla Ollamy.
COMPOSE_PROFILES=ollama
LLM_BASE_URL=http://llm:11434
# Modal: proxy auth token (puste dla lokalnej Ollamy)
LLM_AUTH_KEY=
LLM_AUTH_SECRET=
LLM_MODEL=qwen3:8b
# Inne modele do wyboru parametrem ?model= w /forms/convert (po przecinku)
LLM_MODELS=
LLM_TIMEOUT_S=240
LLM_TEMPERATURE=0
LLM_SEED=42
LLM_NUM_CTX=8192
LLM_NUM_PREDICT=2048
LLM_MAX_CHUNK_CHARS=4500

# Ekstrakcja / konwersja
OCR_LANG=pol
OCR_DPI=300
CONVERTER_TIMEOUT_S=60

# Budowa formularza
INITIAL_DATA_IDENTITY_SOURCE=MLPZ
FINISH_PAGE_STYLE=info_section
MAX_SECTIONS_PER_PAGE=8
# Adres klauzuli informacyjnej RODO (np. w BIP urzędu); bez niego zgoda nie ma linku
# i raport konwersji zawiera ostrzeżenie W28_RODO_CLAUSE_URL_MISSING.
# Tylko adres https://.
# RODO_CLAUSE_URL=https://bip.example.gov.pl/klauzula-informacyjna
